# Copy to .env.local (Next.js dev) — the batch CLI reads .env.local and .env too.

# --- Required for generation (web app and batch CLI) ---
# Google AI Studio API key (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Optional model tuning ---
# Model chain, most preferred first. Free-tier quotas are per model, so when one model's
# daily quota is used up (or it is overloaded) the next takes over. Default:
# GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.6-flash
# Minimum milliseconds between model requests, to stay under requests-per-minute limits (default 4000).
# GEMINI_MIN_INTERVAL_MS=4000

# --- Web app only (the batch CLI needs no database) ---
# Postgres connection string (Neon free tier). Accounts, sessions, kits and generation jobs.
# For local development without an account: DATABASE_URL=pglite://.data/pg
DATABASE_URL=

# Let the web app fetch private / loopback addresses. Leave unset in production (SSRF protection).
# The batch CLI always allows them, because evaluation sites may be served from localhost.
# ALLOW_PRIVATE_URLS=true
